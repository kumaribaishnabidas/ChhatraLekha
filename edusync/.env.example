# EduSynC - backend configuration (development)
#
# Copy this file to `.env` and edit it. Nothing sensitive is committed.
#
# MONGODB_URL
#   A real MongoDB server, e.g. mongodb://localhost:27017
#   Leave it EMPTY to use the built-in in-memory MongoDB. The in-memory
#   database is seeded automatically on start-up, so the portal is
#   demonstrable with a single command and no external service.
MONGODB_URL=
MONGODB_DATABASE=edusync
MONGODB_TIMEOUT_MS=5000

# Secrets - change every one of these before deploying.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
SEAL_HMAC_KEY=change-me-to-a-random-hmac-key
# Optional: a separate key for the keyed APAAR match token. Falls back to
# SEAL_HMAC_KEY when empty.
MATCH_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# The private signing key for Ed25519 seals. Generate one with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey;
#   from cryptography.hazmat.primitives import serialization;
#   print(serialization.Encoding.PEM PrivateFormat PKCS8)"
SEAL_ECDSA_PRIVATE_KEY_PEM=
SEAL_ECDSA_PUBLIC_KEY_PEM=
SEAL_KEY_ID=edusync-2024-01

APP_NAME=EduSynC
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
UPLOAD_MAX_SIZE_MB=10
BCRYPT_ROUNDS=12
