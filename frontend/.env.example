# EduSynC - web frontend configuration
#
# VITE_* variables are read at BUILD time, not at run time. Changing one
# requires a new deployment, not just a restart.
#
# Copy this file to `.env.local` for local development.

# The base URL of the EduSynC API.
#
#   - On a SPLIT deployment (Vercel frontend + Render backend) this MUST be
#     set to the Render URL, with no trailing slash, e.g.
#     https://edusync-api.onrender.com
#     The Vercel rewrite sends every path - `/api` included - to index.html,
#     so an unset value would make the app receive HTML instead of JSON.
#     Set it before the first build; changing it later needs a redeploy.
#   - Leave it unset only when the API serves the frontend as well: the
#     Docker Compose setup, or the backend on port 8000 with the Vite dev
#     server proxying `/api`.
VITE_API_URL=http://localhost:8000
