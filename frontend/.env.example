# ChhatraLekha - web frontend configuration
#
# VITE_* variables are read at BUILD time, not at run time. Changing one
# requires a new deployment, not just a restart.
#
# Copy this file to `.env.local` for local development.

# The base URL of the ChhatraLekha API.
#
#   - Two-project Vercel deployment (Vercel frontend + Vercel FastAPI backend):
#     Set this to the production URL of your backend project, with no
#     trailing slash, e.g. https://chhatralekha-api.vercel.app.
#   - Split deployment (Vercel frontend + Render backend):
#     Set to the Render backend URL, e.g. https://chhatralekha-api.onrender.com.
#   - Unified multi-service deployment (frontend + API in one project):
#     Leave this variable UNSET (or empty) in production. Requests to `/api`
#     are rewritten to the backend service on the same domain.
#   - Local development: set to http://localhost:8000 or leave unset when
#     using the Vite dev server proxy.
VITE_API_URL=http://localhost:8000

# Canonical public origin of this frontend deployment, used for Open Graph,
# Twitter card previews, and sitemap generation (default: https://chhatralekha.vercel.app).
VITE_SITE_URL=https://chhatralekha.vercel.app

# Public inquiries email displayed on the contact page and public footer.
VITE_CONTACT_EMAIL=contact@chhatralekha.test

# Physical or official institutional postal address (optional).
VITE_CONTACT_ADDRESS=""

# Optional privacy-first analytics endpoint (no cookies, anonymous).
# VITE_ANALYTICS_URL=https://analytics.example.gov.in
