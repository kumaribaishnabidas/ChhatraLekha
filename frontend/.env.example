# EduSynC - web frontend configuration
#
# VITE_* variables are read at BUILD time, not at run time. Changing one
# requires a new deployment, not just a restart.
#
# Copy this file to `.env.local` for local development.

# The base URL of the EduSynC API.
#
#   - Leave it unset in production: the frontend is then served from the same
#     origin as the API (or through the Vercel rewrite), and "/api" is used.
#   - Set it to the Render URL for a split deployment, e.g.
#     https://edusync-api.onrender.com
#   - For local development, http://localhost:8000 works, and the Vite dev
#     server proxies /api to the backend anyway.
VITE_API_URL=http://localhost:8000
