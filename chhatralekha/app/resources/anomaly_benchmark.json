    {"id": "R06", "anomaly_type": "SUPERNUMERARY_BREACH", "name": "Supernumerary quota ceiling", "active_only": true},
    {"id": "R07", "anomaly_type": "INCONSISTENT_CATEGORY", "name": "Documentary / quota consistency", "active_only": false},
    {"id": "R08", "anomaly_type": "IMPOSSIBLE_DATE", "name": "Impossible dates", "active_only": false},
    {"id": "R09", "anomaly_type": "MISSING_REQUIRED_FIELD", "name": "Missing mandatory fields", "active_only": false},
    {"id": "R10", "anomaly_type": "UNSANCTIONED_PROGRAM", "name": "Unsanctioned programme", "active_only": false}
