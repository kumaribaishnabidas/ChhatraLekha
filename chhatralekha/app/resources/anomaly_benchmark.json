{
  "version": "1.0.0",
  "ruleset_id": "CHHATRALEKHA_RULES_2026_V1",
  "fixture_seed": "synthetic-anomaly-benchmark-v1",
  "unit_of_evaluation": "case student / rule pair",
  "description": "Deterministic, fully synthetic benchmark for the ten documented anomaly rules. Each case is an independent snapshot. APAAR IDs are reused across cases because snapshots are never combined; case_id values are unique across the dataset.",
  "rules": [
