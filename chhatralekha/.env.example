# ChhatraLekha - backend configuration
#
# Copy this file to `.env` and edit it. Nothing sensitive is committed.

# ---------------------------------------------------------------- database
# A real MongoDB server. On MongoDB Atlas this is the `mongodb+srv://...`
# string from the cluster's "Connect" dialog. URL-encode any special
# characters in the database password.
MONGODB_URL=mongodb://localhost:27017
# The database name inside the cluster.
MONGODB_DATABASE=edusync
MONGODB_TIMEOUT_MS=5000

# The in-memory database is a DEMO AND TEST FACILITY ONLY. It has to be asked
# for explicitly, it is never used in production, and nothing is persisted.
# Set it to true only when you want the throwaway demo dataset.
ALLOW_IN_MEMORY_DB=false

# ------------------------------------------------------------------ secrets
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SEAL_HMAC_KEY=change-me-to-a-random-hmac-key
# Optional: a separate key for the keyed APAAR match token. Falls back to
# SEAL_HMAC_KEY when empty.
MATCH_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# The lifetime of a verification token, in minutes.
VERIFICATION_TOKEN_MINUTES=60

# --------------------------------------------------------------------- web
# The public origin of the React frontend. It is used for CORS and for the
# links printed on a QR badge. On a split deployment this is the Vercel URL,
# e.g. https://chhatralekha.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# A comma-separated list of extra allowed origins. FRONTEND_ORIGIN is always
# included, and a wildcard is never allowed.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ------------------------------------------------------------------ limits
RATE_LIMIT_PER_MINUTE=60
UPLOAD_MAX_SIZE_MB=10
BCRYPT_ROUNDS=12

# --------------------------------------------------------------- demo data
# The password of the seeded demo accounts. When it is empty, the seed script
# generates one and prints it once. It is never stored in the repository.
DEMO_PASSWORD=
# Seeding a production database is refused unless this is switched on.
ALLOW_PRODUCTION_SEED=false

# ------------------------------------------------------------------- app
APP_NAME=ChhatraLekha
# `dev`, `test` or `production`. `ENV` is accepted as an alias.
ENVIRONMENT=dev
DEBUG=false

# ------------------------------------------------------- Google sign-in
# Create an OAuth 2.0 client in the Google Cloud console (Web application),
# and add the redirect URI shown below. When both the id and the secret are
# present, the portal offers "Sign in with Google".
#
#   GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#   GOOGLE_CLIENT_SECRET=xxxx
#
# The redirect URI must match exactly. Leave it empty to derive it from the
# incoming request, which is what a local development run wants:
#   {the backend URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# The role given to somebody signing in with Google for the first time.
GOOGLE_DEFAULT_ROLE=verifier
